{
  "name": "sijass-clean-architecture",
  "version": "1.0.0",
  "private": true,
  "description": "Prototipo de dominio SIJASS, sin IA real ni backend",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "npm run build && node --test dist/pruebas/unitarias/*.test.js",
    "test:integration": "npm run build && node scripts/exigir-database-url.mjs && node --test --test-concurrency=1 dist/pruebas/integracion/*.test.js",
    "migrar": "node-pg-migrate up -m migraciones",
    "migrar:revertir": "node-pg-migrate down -m migraciones"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
