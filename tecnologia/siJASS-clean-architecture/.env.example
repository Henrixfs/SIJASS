# Copia este archivo a `.env` (ignorado por git) o exporta la variable en tu terminal.
# Credenciales desechables del PostgreSQL de `docker-compose.yml`; no son secretos.
#
# bash:        export DATABASE_URL=postgres://sijass:sijass@127.0.0.1:5432/sijass
# PowerShell:  $env:DATABASE_URL = "postgres://sijass:sijass@127.0.0.1:5432/sijass"
#
# Si el puerto 5432 está ocupado por otro PostgreSQL, arranca el contenedor con
# SIJASS_PG_PUERTO=5433 y cambia el puerto en la URL.
DATABASE_URL=postgres://sijass:sijass@127.0.0.1:5432/sijass
