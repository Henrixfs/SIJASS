# Copie a `.env.despliegue` (que NO se versiona) y complete los valores. Esto es solo un ejemplo.
# Genere el secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SIJASS_DB_CLAVE=
# Opcionales
SIJASS_DB_USUARIO=sijass
SIJASS_DB_NOMBRE=sijass
SIJASS_PUERTO=3000
# Solo con el perfil `https` (dominio con DNS apuntando al servidor):
SIJASS_DOMINIO=
# Con el perfil `https` y el puerto 3000 sin publicar, ponga 1 para que el límite de intentos cuente por la dirección real del visitante:
TRUST_PROXY=
